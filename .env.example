# ============================================================
# CF NewAPI Gateway 配置（复制为 .env 后按需修改）
# 优先级：进程环境变量 > 本文件 > 代码默认值
# ============================================================

# ---------- 必改：管理后台 ----------
ADMIN_USER=admin
ADMIN_PASSWORD=请改成强密码
# 管理后台登录后请立刻修改；留空会使用内置默认密码（极不安全）

# ---------- 必改：对外访问地址 ----------
# 填写 New API 能访问到的地址（域名或 IP:端口），末尾不要加斜杠
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------- 端口 ----------
# 容器内监听端口
GATEWAY_PORT=8000
# 宿主机映射端口（compose 用）
GATEWAY_HOST_PORT=8000

# ---------- 数据目录 ----------
# 容器内固定 /data（对应 compose 的 ./data 卷）；裸机部署可改为 ./data
DATA_DIR=/data

# ---------- 加密密钥（可选）----------
# 用于加密账号 Cookie / 签发管理后台 JWT；留空则首次启动自动生成并落盘 DATA_DIR/.secret_key
# 多实例共享同一数据库时必须显式指定同一个值
SECRET_KEY=

# ---------- 出网代理（一般不用填）----------
# 默认行为：**忽略**从父 shell 继承的 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY，直连出网。
# 原因：这类代理多是启动 shell 的会话级代理（IDE 终端等），会话一结束就消失，
#       而常驻进程仍拿着旧值 → 表现为「端口在监听、/health 正常，但上传/提交全挂」，
#       报 Failed to connect to proxy URL: http://127.0.0.1:xxxxx。
# 确实需要走代理时，显式填写（会同时写入大小写两套变量）：
RELAY_OUTBOUND_PROXY=
# 仅调试用：设 1 则保留父进程原有的代理变量不做清理
RELAY_KEEP_PROXY_ENV=

# ---------- 任务调度 ----------
WORKER_INTERVAL=2          # worker 循环间隔（秒）
POLL_INTERVAL=10           # 生成结果轮询间隔（秒）
REQUEST_GAP=3              # 同一账号两次请求最小间隔（秒，防风控）
MAX_RETRIES=2              # 任务失败重试次数
TOOLS_SYNC_INTERVAL=3600   # CF 渠道工具目录同步间隔（秒）

# ---------- CapCut 参考素材上传 ----------
# 参考素材「下载 -> 上传 CapCut」阶段的并发线程数（1-8）。数量大时（Seedance 2.5 参考模式
# 最多 30 图 + 10 视频 + 10 音频）串行会拖很久，默认 4；上传顺序始终与入参一致。
CAPCUT_REF_UPLOAD_WORKERS=4

# ---------- CapCut 请求签名 ----------
# sign 算法已从前端逆向（md5("9e2c|路径末7字符|pf|appvr|device-time|tdid|11ac")），
# 默认 auto=账号存过就用/否则按当前时间现签（推荐）；
# mint=永远现签；static=只用后台/内置常量（排查用）。详见 DEPLOY.md 9.4 节。
CAPCUT_SIGN_MODE=auto

# ---------- CapCut 反爬参数（风控第一道门，详见 DEPLOY.md 9.5 节）----------
# common_task/new 返回 ret=-6 shark block only 时，是缺 URL 查询串上的 X-Gnarly（不是 sign，也不只是 d_ticket）。
# 默认 on：自动给所有 CapCut edit-api 请求注入内置的 X-Gnarly / X-Bogus。
# 失效（换设备/会话）后重新抓：浏览器 DevTools → 任意 edit-api 请求 → Copy as cURL →
#   python -m app.capcut_antibot <har或cURL文本>  然后把值填到下面。
CAPCUT_ANTIBOT=on
#CAPCUT_XGNARLY=
#CAPCUT_XBOGUS=

# ---------- Cloudflare R2 成片转存 ----------
# 五项全部填写才生效；缺任一项则「官转」密钥自动回退为官链
# 用于：① 参考素材上传中转（/v1/files）② 「官转」模式成片镜像 ③ CF 通道成片镜像
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 桶的公开访问地址：自定义域名（推荐）或 https://pub-xxxx.r2.dev
R2_PUBLIC_BASE=
# 对象键前缀，便于和桶内其他业务区分
R2_KEY_PREFIX=cf-gateway/

# 参考素材（ref/ 前缀）保留时长（小时），到期由 worker 每 6 小时自动清理。0 = 不清理
R2_REF_RETENTION_HOURS=48

# ---------- Creative Fabrica MCP / OAuth（一般不用改）----------
MCP_ENDPOINT=https://mcp.creativefabrica.com/mcp
MCP_RESOURCE=https://mcp.creativefabrica.com/mcp
OAUTH_ISSUER=https://oauth.creativefabrica.com
OAUTH_SCOPES=mcp:read mcp:generate offline_access
